{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "forexai.quant_constitution.v1",
  "purpose": "Machine-readable non-bypassable baseline for research, validation, risk, capital and execution boundaries.",
  "principles": [
    "AI may propose but may not self-authorize.",
    "Evidence is scoped, immutable after freeze, and invalidated when dependencies change.",
    "No authorization means no capital exposure.",
    "Unknown, stale, invalid or out-of-scope state is not equivalent to PASS.",
    "Research has no direct production-capital capability.",
    "Production cannot rewrite historical evidence.",
    "OOS data is inaccessible to discovery and optimization processes.",
    "Every executable trade must have a current authorization and a deterministic provenance chain."
  ],
  "capabilities": {
    "research": {
      "allow": [
        "create_hypothesis",
        "create_candidate",
        "run_research",
        "analyze_failure"
      ],
      "deny": [
        "read_pristine_oos",
        "approve_self",
        "authorize_capital",
        "send_order",
        "modify_constitution"
      ]
    },
    "validation": {
      "allow": [
        "validate_candidate",
        "attack_candidate",
        "produce_evidence",
        "reproduce_candidate"
      ],
      "deny": [
        "modify_candidate_after_freeze",
        "read_pristine_oos_before_final_evaluation",
        "authorize_capital",
        "send_order",
        "modify_constitution"
      ]
    },
    "risk": {
      "allow": [
        "evaluate_risk",
        "reserve_capital",
        "issue_authorization",
        "revoke_authorization"
      ],
      "deny": [
        "modify_historical_evidence",
        "modify_research_history",
        "change_constitution"
      ]
    },
    "execution": {
      "allow": [
        "submit_authorized_order",
        "reconcile_broker_state",
        "manage_protective_state"
      ],
      "deny": [
        "create_strategy",
        "approve_strategy",
        "increase_authorized_risk",
        "modify_historical_evidence",
        "change_constitution"
      ]
    }
  },
  "hard_boundaries": {
    "oos": {
      "discovery_read": false,
      "optimization_read": false,
      "validation_read": false,
      "final_evaluation_read": true,
      "production_write": false
    },
    "capital": {
      "default_authorized_risk": 0,
      "unauthorized_exposure_must_equal": 0,
      "risk_must_not_exceed_authorization": true,
      "expired_authorization_must_not_execute": true,
      "max_authorized_risk": 0.006,
      "risk_unit": "equity_fraction"
    },
    "evidence": {
      "frozen_history_is_append_only": true,
      "dependency_change_invalidates_downstream_evidence": true
    }
  },
  "required_trade_proof": [
    "snapshot_id",
    "decision_id",
    "strategy_id",
    "model_id",
    "policy_version",
    "risk_authorization_id",
    "authorization_expiry",
    "input_hash",
    "execution_contract_version"
  ],
  "required_trade_states": [
    "PROPOSED",
    "VALIDATED",
    "RISK_RESERVED",
    "AUTHORIZED",
    "ORDER_SUBMITTED",
    "ACCEPTED",
    "FILLED",
    "OPEN",
    "MANAGED",
    "CLOSED",
    "RECONCILED"
  ],
  "forbidden_direct_transitions": [
    [
      "HYPOTHESIS",
      "AUTHORIZED"
    ],
    [
      "HYPOTHESIS",
      "FILLED"
    ],
    [
      "MODEL",
      "RISK_RESERVED"
    ],
    [
      "MODEL",
      "AUTHORIZED"
    ],
    [
      "DECISION_PROPOSAL",
      "FILLED"
    ],
    [
      "RISK_REQUEST",
      "FILLED"
    ],
    [
      "PROPOSED",
      "FILLED"
    ],
    [
      "CLOSED",
      "OPEN"
    ],
    [
      "RETIRED",
      "PRODUCTION"
    ]
  ],
  "invariants": [
    "unauthorized_exposure == 0",
    "actual_risk <= authorized_risk",
    "executed_trade.authorization_exists == true",
    "executed_trade.authorization_not_expired == true",
    "invalid_model_output_cannot_be_executable_direction == true",
    "unresolved_reconciliation_blocks_new_risk == true",
    "research_process_oos_access == false",
    "production_cannot_mutate_frozen_evidence == true",
    "duplicate_request_cannot_create_duplicate_exposure == true",
    "restart_does_not_clear_safety_state == true",
    "mql5_execution_semantic_parity_audit == PASS",
    "deterministic_replay_digest_stable == true"
  ]
}
