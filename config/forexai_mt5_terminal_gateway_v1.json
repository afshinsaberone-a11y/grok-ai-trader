{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "forexai.mt5_terminal_gateway.v1",
  "purpose": "Real broker-backed MetaTrader 5 Python gateway. No synthetic broker responses are permitted.",
  "account_policy": {
    "default_mode": "DEMO_ONLY",
    "live_trading_permitted_in_p0": false,
    "real_account_requires_external_confirmation_env": null
  },
  "platform": {
    "terminal": "MetaTrader 5",
    "python_package": "MetaTrader5",
    "supported_runner": "Windows self-hosted with MT5 terminal"
  },
  "transport": {
    "initialize_required": true,
    "symbol_info_required": true,
    "symbol_tick_required": true,
    "order_check_required": true,
    "order_send_required": true,
    "automatic_retry": false,
    "unknown_transport_outcome": "RECONCILIATION_REQUIRED"
  },
  "execution": {
    "action": "TRADE_ACTION_DEAL",
    "success_requires": [
      "TRADE_RETCODE_DONE",
      "nonzero_deal_ticket"
    ],
    "partial_status": "PARTIAL",
    "placed_without_deal_status": "PENDING",
    "malformed_done_without_deal": "FAIL_CLOSED"
  },
  "filling": {
    "selection": "symbol_execution_mode_aware",
    "market_execution": "choose_supported_FOK_or_IOC",
    "non_market_execution": "ORDER_FILLING_RETURN"
  },
  "authority": {
    "capital_authority_source": "CapitalFirewall",
    "execution_admission_authentication": {
      "required": true,
      "schema": "forexai.execution_admission_authentication.v1",
      "algorithm": "HMAC-SHA256",
      "secret_source": "external_runtime_secret",
      "verify_before_mt5_initialize": true,
      "constant_time_compare": true
    },
    "control_plane_authentication_required_before_gateway": true,
    "gateway_cannot_grant_authority": true,
    "default_demo_only": true
  }
}
