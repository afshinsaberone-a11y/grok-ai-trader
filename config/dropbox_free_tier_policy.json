{
  "schema_version": "forexai.dropbox_free_tier_policy.v2",
  "plan": "Dropbox Basic",
  "quota_bytes": 2000000000,
  "reserve_bytes": 268435456,
  "max_run_upload_bytes": 15728640,
  "max_file_upload_bytes": 5242880,
  "max_csv_upload_bytes": 2097152,
  "allowed_extensions": [
    ".json",
    ".md",
    ".txt",
    ".csv",
    ".html",
    ".mq5",
    ".ex5"
  ],
  "denied_extensions": [
    ".zip",
    ".parquet",
    ".feather",
    ".bi5",
    ".gz",
    ".7z",
    ".tar",
    ".db",
    ".sqlite"
  ],
  "denied_path_tokens": [
    "/data/real/",
    "/normalized/",
    "/download/",
    "/dukascopy/",
    "/histdata/",
    "/raw_market_data/",
    "/raw/"
  ],
  "binary_allow_tokens": [
    "compile-parity",
    "demo-package",
    "mql5-release"
  ],
  "store_full_market_datasets": false,
  "store_full_workflow_archives": false,
  "store_release_binaries": true,
  "policy_notes": [
    "Dropbox is the durable evidence plane, not the primary market-data lake.",
    "Raw and normalized historical datasets must remain outside Dropbox Basic unless explicitly approved for a small sample.",
    "Promotion, OOS, validation, robustness and parity manifests are high-priority evidence.",
    "When projected upload would violate quota or reserve, synchronization must fail closed.",
    "Remote evidence paths are write-once: existing content must match SHA-256 exactly or synchronization fails closed.",
    "Replaying the same source run and attempt is idempotent when the remote bytes are identical.",
    "No automatic deletion is permitted by this policy.",
    "Workflow-scoped artifact allowlisting is fail-closed: only recognized artifact families for the triggering workflow can enter Dropbox."
  ],
  "allowed_filename_tokens": [
    "manifest",
    "validation",
    "robustness",
    "oos",
    "promotion",
    "candidate",
    "evidence",
    "audit",
    "parity",
    "compile",
    "preflight",
    "decision",
    "summary",
    "handoff",
    "integrity",
    "capacity",
    "milestone",
    "report"
  ],
  "denied_filename_tokens": [
    "eurusd_m1",
    "eurusd_m5",
    "eurusd_m15",
    "xauusd_m1",
    "xauusd_m5",
    "xauusd_m15",
    "ohlc",
    "ticks",
    "market_data",
    "normalized",
    "historical"
  ],
  "critical_filename_tokens": [
    "manifest",
    "promotion",
    "validation",
    "robustness",
    "oos",
    "parity",
    "compile",
    "decision",
    "audit",
    "integrity"
  ],
  "standard_filename_tokens": [
    "candidate",
    "evidence",
    "preflight",
    "summary",
    "handoff",
    "capacity",
    "milestone",
    "report"
  ],
  "manifest_reserve_bytes": 524288,
  "max_manifest_bytes": 1048576,
  "require_known_workflow_profile": true,
  "workflow_profiles": {
    "forexai-g13-final-promotion-m15": {
      "allowed_artifact_prefixes": [
        "g13-promotion-manifest-m15"
      ]
    },
    "forexai-g13-mt5-compile-signal-parity": {
      "allowed_artifact_prefixes": [
        "g13-mt5-compile-parity-",
        "g13-mt5-parity-diagnostics-"
      ]
    },
    "forexai-g13-oos-m15-current": {
      "allowed_artifact_prefixes": [
        "g13-oos-m15-2026-current"
      ]
    },
    "forexai-g13-agent-evidence-consumer": {
      "allowed_artifact_prefixes": [
        "g13-agent-evidence"
      ]
    },
    "forexai-g13-controlled-demo-package-preflight-m15": {
      "allowed_artifact_prefixes": [
        "g13-controlled-demo-package-preflight-m15"
      ]
    },
    "dukascopy-cross-feed-check": {
      "allowed_artifact_prefixes": [
        "dukascopy-node-cross-check-"
      ]
    },
    "forexai-v29-1-robustness-validation": {
      "allowed_artifact_prefixes": [
        "robustness-validation-v29-1-"
      ]
    },
    "forexai-v29-1-robustness-validation-m1": {
      "allowed_artifact_prefixes": [
        "robustness-validation-v29-1-m1"
      ]
    },
    "forexai-v29-1-robustness-validation-m15": {
      "allowed_artifact_prefixes": [
        "robustness-validation-v29-1-m15"
      ]
    }
  }
}
